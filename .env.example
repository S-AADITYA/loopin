# Copy this file to .env.local for local dev, and set the same keys
# in your Vercel project settings (Settings -> Environment Variables)
# for production/preview deploys.

# From Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Never expose the service_role key to the client or commit it.
# Only used server-side (not referenced by any client code in this starter).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
